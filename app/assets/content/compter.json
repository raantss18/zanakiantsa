        "texte": "Dénombrer une collection d’objets (jusqu’à six)."
      },
      "activite": "denombrer",
      "parametres": {
        "min": 2,
        "max": 6,
        "objet": 1
      },
      "phrases": {
        "consigne": "Touche chaque {objet} pour compter.",
        "question": "Combien de {objets} ?",
        "indice": "Touche les {objets} {un} par {un}, sans en oublier.",
        "exemple": "Le dernier nombre dit, c'est le nombre de {objets}.",
        "demonstration": "Regarde : je compte avec toi. Il y a {n} {objets}.",
        "bravo": "Oui, il y a {n} {objets}."
      }
    },
    {
      "id": "denombrer-10",
      "titre": "Compter jusqu'à 10",
      "niveau": "GS",
      "prerequis": [
        "denombrer-6"
      ],
      "programme": {
        "source": "cycle1",
        "texte": "Dénombrer une collection d’objets (jusqu’à dix, voire au-delà)."
      },
      "activite": "denombrer",
      "parametres": {
        "min": 6,
        "max": 10,
        "objet": 2
      },
      "phrases": {
        "consigne": "Touche chaque {objet} pour compter.",
        "question": "Combien de {objets} ?",
        "indice": "Touche les {objets} {un} par {un}, sans en oublier.",
        "exemple": "Le dernier nombre dit, c'est le nombre de {objets}.",
        "demonstration": "Regarde : je compte avec toi. Il y a {n} {objets}.",
        "bravo": "Oui, il y a {n} {objets}."
      }
    },
    {
      "id": "constituer-10",
      "titre": "Mettre le bon nombre",
      "niveau": "GS",
      "prerequis": [
        "denombrer-6"
      ],
      "programme": {
        "source": "cycle1",
        "texte": "Constituer une collection d’un cardinal donné (jusqu’à dix, voire au-delà)."
      },
      "activite": "composer",
      "parametres": {
        "cible_min": 3,
        "cible_max": 10,
        "depart_min": 0,
        "depart_max": 0
      },
      "phrases": {
        "consigne": "Mets {n} {objets} dans {contenant}.",
        "question": "As-tu mis {n} {objets} ? Appuie sur ✔.",
        "indice": "Compte les {objets} dans {contenant}, {un} par {un}.",
        "exemple": "Trop ? Touche {contenant} pour en enlever.",
        "demonstration": "Regarde : un, deux… jusqu'à {n}. Voilà {n} {objets}.",
        "bravo": "Oui, il y a {n} {objets} dans {contenant}."
      }
    },
    {
      "id": "composer-10",
      "titre": "Compléter jusqu'à un nombre",
      "niveau": "GS",
      "prerequis": [
        "constituer-10"
      ],
      "programme": {
        "source": "cycle1",
        "texte": "Composer et décomposer des nombres inférieurs ou égaux à dix, voire au-delà."
      },
      "activite": "composer",
      "parametres": {
        "cible_min": 4,
        "cible_max": 10,
        "depart_min": 1,
        "depart_max": 6
      },
      "phrases": {
        "consigne": "Il y a {a} {objets}. Ajoute-en pour en avoir {n}.",
        "question": "As-tu {n} {objets} ? Appuie sur ✔.",
        "indice": "Compte à partir de {a} : {a}, puis le suivant…",
        "exemple": "Ajoute {un} {objet} à la fois et compte jusqu'à {n}.",
        "demonstration": "Regarde : {a}, puis j'ajoute {b}. {a} et {b} font {n}.",
        "bravo": "Oui ! {a} et {b} font {n}."
      }
    },
    {
      "id": "additionner-5",
      "titre": "Additions jusqu'à 5",
      "niveau": "CP",
      "prerequis": [
        "composer-10"
      ],
      "programme": {
        "source": "cycle2",
        "texte": "Connaitre dans les deux sens les tables d’addition (A + B = C, A et B entre 0 et 10)."
      },
      "activite": "calcul",
      "parametres": {
        "forme": "somme",
        "total_max": 5
      },
      "phrases": {
        "consigne": "Écris le résultat avec ton doigt.",
        "question": "{prenom} a {a} {objets}. Il en arrive {b}. Combien en tout ?",
        "indice": "Tu peux compter sur tes doigts : {a}, puis {b} de plus.",
        "exemple": "Pense à {a} {objets} et encore {b} {objets}.",
        "demonstration": "Regarde : {a} et {b} font {n}.",
        "bravo": "Oui, {a} plus {b} égale {n}."
      }
    },
    {
      "id": "additionner-10",
      "titre": "Additions jusqu'à 10",
      "niveau": "CP",
      "prerequis": [
        "additionner-5"
      ],
      "programme": {
        "source": "cycle2",
        "texte": "Connaitre dans les deux sens les tables d’addition (A + B = C, A et B entre 0 et 10)."
      },
      "activite": "calcul",
      "parametres": {
        "forme": "somme",
        "total_max": 10
      },
      "phrases": {
        "consigne": "Écris le résultat avec ton doigt.",
        "question": "{prenom} a {a} {objets}. Il en arrive {b}. Combien en tout ?",
        "indice": "Pars du plus grand nombre et compte le petit en plus.",
        "exemple": "Pour {a} plus {b} : pars de {a} et avance de {b}.",
        "demonstration": "Regarde : {a} et {b} font {n}.",
        "bravo": "Oui, {a} plus {b} égale {n}."
      }
    },
    {
      "id": "complement-10",
      "titre": "Compléments à 10",
      "niveau": "CP",
      "prerequis": [
        "additionner-10"
      ],
      "programme": {
        "source": "cycle2",
        "texte": "Égalités à trou du type : 10 = 7 + …"
      },
      "activite": "calcul",
      "parametres": {
        "forme": "complement",
        "total_max": 10,
        "total_fixe": 10
      },
      "phrases": {
        "consigne": "Écris le nombre qui manque avec ton doigt.",
        "question": "{prenom} veut {n} {objets}. Il y en a {a}. Combien en manque-t-il ?",
        "indice": "Compte à partir de {a} jusqu'à {n}.",
        "exemple": "Montre {a} doigts. Combien de doigts restent baissés ?",
        "demonstration": "Regarde : {a} et {b} font {n}.",
        "bravo": "Oui, {a} plus {b} égale {n}."
      }
    }
